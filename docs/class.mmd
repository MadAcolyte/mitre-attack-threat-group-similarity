classDiagram
    class Notebook {
      +run(techniques, k) Output
    }
    class JaccardMatcher {
      -store IncidentStore
      +match(techniques, k) List~Match~
    }
    class IncidentStore {
      -incidents
      -invertedIndex
      +load(path)
      +get(incidentId)
      +candidates(techniques)
    }
    class Gemini {
      +explain(techniques, matches) str
    }
    class Output {
      +matches
      +explanation
      +chart()
    }
    class Match {
      +incidentId
      +jaccard
      +matchPercentage
      +sharedTechniques
      +group
    }

    Notebook --> JaccardMatcher
    Notebook --> IncidentStore
    Notebook --> Gemini
    Notebook --> Output
    JaccardMatcher --> IncidentStore
    JaccardMatcher --> Match
    Output --> Match
