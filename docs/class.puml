@startuml
title Threat group similarity — class diagram

class Notebook {
  +run(techniques: List<String>, k: int): Output
}

class JaccardMatcher {
  -store: IncidentStore
  +match(techniques: List<String>, k: int): List<Match>
}

class IncidentStore {
  -incidents: List<Incident>
  -byId: Map<String, Incident>
  -invertedIndex: Map<String, Set<int>>
  +load(path)
  +get(incidentId): Incident
  +candidates(techniques): Set<int>
}

class Gemini {
  +explain(techniques, matches): String
}

class Output {
  +matches: List<Match>
  +explanation: String
  +chart()
}

class Match {
  +incidentId: String
  +jaccard: float
  +matchPercentage: float
  +sharedTechniques: List<String>
  +group: String
}

Notebook --> JaccardMatcher
Notebook --> IncidentStore
Notebook --> Gemini
Notebook --> Output
JaccardMatcher --> IncidentStore
Output --> Match
JaccardMatcher --> Match
@enduml
